// 说明：这是 android/app/build.gradle 的关键配置片段。
// 使用 flutter create 生成项目后，将以下内容合并进生成的 build.gradle。

android {
    namespace "com.adshield.app"
    compileSdk 35

    defaultConfig {
        applicationId "com.adshield.app"
        minSdk 24        // Jetpack WindowManager 折叠姿态监听需要较新的 API，24 为安全下限
        targetSdk 35
        versionCode 1
        versionName "1.0.0"
    }
}

dependencies {
    // 折叠屏姿态监听（HALF_OPENED / FLAT / 铰链边界）
    implementation "androidx.window:window:1.3.0"
    implementation "androidx.window:window-java:1.3.0"
    implementation "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.8.1"
}
