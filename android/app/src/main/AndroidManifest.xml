<?xml version="1.0" encoding="utf-8"?>
<!-- 说明：这是 android/app/src/main/AndroidManifest.xml 的完整内容。
     使用 flutter create 生成项目后，用它覆盖生成的默认 Manifest。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 拦截引擎所需权限 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="AdShield"
        android:name="com.adshield.app.AdShieldApplication"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 折叠屏关键：声明支持尺寸/形态变化，避免展开瞬间 Activity 重建导致闪屏 -->
            <meta-data
                android:name="android.app.resizeable_activity"
                android:value="true" />
        </activity>

        <!-- 本地 VPN 过滤服务 -->
        <service
            android:name=".FilterVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="dns_ad_filter" />
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
</manifest>
